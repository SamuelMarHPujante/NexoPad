<Window x:Class="NexoPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NexoPad"
        mc:Ignorable="d"
        Title="NexoPad" Height="350" Width="500">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="txtSaludo" Text="NexoPad" FontSize="36" FontWeight="Bold"
        Foreground="SteelBlue" HorizontalAlignment="Center"/>
                
        <Button x:Name="btnEditor" Content="Escanear carpeta y editar"
        Width="150" Height="35" Margin="0,20,0,0" Click="Menus_Click"/>
    </StackPanel>
</Window>
