<Window x:Class="NexoPad._01view.Editor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NexoPad._01view"
        mc:Ignorable="d"
        Title="Editor" Height="600" Width="1200"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ListBox DockPanel.Dock="Right" Width="200">
            <ListBoxItem>
                <TextBlock x:Name="TxtTipo"/>
            </ListBoxItem>

            <ListBoxItem>
                <TextBlock x:Name="TxtCategoria"/>
            </ListBoxItem>

            <ListBoxItem>
                <TextBlock x:Name="TxtTamanyo"/>
            </ListBoxItem>
            <Separator/>

            <ListBoxItem>
                <TextBlock x:Name="TxtCreado"/>
            </ListBoxItem>

            <ListBoxItem>
                <TextBlock x:Name="TxtModificado"/>
            </ListBoxItem>

            <ListBoxItem>
                <TextBlock x:Name="TxtUltimoAcceso"/>
            </ListBoxItem>
        </ListBox>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Nuevo"/>
                <MenuItem Header="_Guardar"/>
                <Separator/>
                <MenuItem Header="_Salir"/>
            </MenuItem>

            <MenuItem Header="_Edición">
                <MenuItem Header="_Copiar"/>
                <MenuItem Header="_Pegar"/>
            </MenuItem>

            <MenuItem Header="_Ayuda">
                <MenuItem Header="_Acerca de"/>
            </MenuItem>
        </Menu>

        <DockPanel DockPanel.Dock="Top" LastChildFill="True">
            <Button x:Name="btnEscanearCarpeta" Content="Escanear" DockPanel.Dock="Left" VerticalAlignment="Center" Padding="5" Click="EscanearCarpeta_Click"/>
            <Button x:Name="btnAbrirCarpeta" Content="Abrir" DockPanel.Dock="Left" VerticalAlignment="Center" Padding="5" Click="AbrirCarpeta_Click"/>

            <Button Content="Borrar" DockPanel.Dock="Right" Padding="5"/>
            <Button Content="Guardar" DockPanel.Dock="Right" Padding="5"/>
            <Button Content="Nueva" DockPanel.Dock="Right" Padding="5"/>

            <TextBox x:Name="TxtUbicacion" VerticalContentAlignment="Center"/>
        </DockPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem HorizontalAlignment="Left">
                <TextBlock Text="Listo"/>
            </StatusBarItem>

            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TxtCantidadNotas" Text="3 notas"/>
            </StatusBarItem>
        </StatusBar>

        <ListBox x:Name="ListaNotas" DockPanel.Dock="Left" Width="200" SelectionChanged="ListaNotas_SelectionChanged"/>

        <TextBox x:Name="EditorTexto" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

    </DockPanel>
</Window>
