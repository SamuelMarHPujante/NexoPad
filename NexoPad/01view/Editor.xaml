<Window x:Class="NexoPad._01view.Editor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NexoPad._01view"
        mc:Ignorable="d"
        Title="Editor" Height="600" Width="1200"
        WindowStartupLocation="CenterScreen" Icon="/NexoPad_single.jpg">
    <DockPanel>
        <ListBox x:Name="lbxPropiedades" DockPanel.Dock="Right" Width="200">
            <ListBoxItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Trasladar" Padding="5" Click="CambiarRuta_Click"/>
                    <Button Content="Refrescar" Padding="5"/>
                    <CheckBox x:Name="cbxRefrescar" Content="Auto" IsChecked="True" VerticalAlignment="Center" Margin="10,0,10,0"/>
                </StackPanel>
            </ListBoxItem>
            <Separator/>

            <ListBoxItem>
                <TextBlock x:Name="txtTipo" Text="X"/>
            </ListBoxItem>

            <ListBoxItem>
                <TextBlock x:Name="txtCategoria" Text="X"/>
            </ListBoxItem>

            <ListBoxItem>
                <TextBlock x:Name="txtTamanyo" Text="X"/>
            </ListBoxItem>
            <Separator/>

            <ListBoxItem>
                <TextBlock x:Name="txtCreado" Text="X"/>
            </ListBoxItem>

            <ListBoxItem>
                <TextBlock x:Name="txtModificado" Text="X"/>
            </ListBoxItem>

            <ListBoxItem>
                <TextBlock x:Name="txtUltimoAcceso" Text="X"/>
            </ListBoxItem>
        </ListBox>

        <Menu DockPanel.Dock="Top">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch" />
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Nuevo"/>
                <MenuItem Header="_Abrir">
                    <MenuItem Header="_Carpeta única" Click="EscanearCarpetaUnica_Click"/>
                    <MenuItem Header="_Carpeta e hijas" Click="EscanearCarpetaConHijas_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Guardar"/>
                <MenuItem Header="_Guardar todo"/>
                <Separator/>
                <MenuItem Header="_Salir"/>
            </MenuItem>

            <MenuItem Header="_Edición">
                <MenuItem Header="_Deshacer"/>
                <MenuItem Header="_Rehacer"/>
                <Separator/>
                <MenuItem Header="_Cortar"/>
                <MenuItem Header="_Copiar"/>
                <MenuItem Header="_Pegar"/>
                <MenuItem Header="_Duplicar"/>
                <MenuItem Header="_Eliminar"/>
            </MenuItem>

            <MenuItem Header="_Ayuda">
                <MenuItem Header="_Acerca de"/>
            </MenuItem>

            <MenuItem Header="Propiedades" HorizontalAlignment="Right" Click="TogglePropiedades_Click"/>
        </Menu>

        <DockPanel DockPanel.Dock="Top" LastChildFill="True">
            <Button x:Name="btnVerCarpeta" Content="Ver" DockPanel.Dock="Left" VerticalAlignment="Center" Padding="5" Click="VerCarpeta_Click"/>

            <Button Content="Borrar" x:Name="btnBorrarRuta" DockPanel.Dock="Right" Padding="5" Click="BorrarRuta_Click"/>
            <Button Content="Pegar" x:Name="btnPegarRuta" DockPanel.Dock="Right" Padding="5" Click="PegarRuta_Click"/>
            <Button Content="Copiar" x:Name="btnCopiarRuta" DockPanel.Dock="Right" Padding="5" Click="CopiarRuta_Click"/>

            <TextBox x:Name="tbxUbicacion" VerticalContentAlignment="Center"/>
        </DockPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem HorizontalAlignment="Left">
                <TextBlock Text="Listo"/>
            </StatusBarItem>

            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="txtCantidadNotas" Text="X"/>
            </StatusBarItem>
        </StatusBar>

        <ListBox x:Name="lbxListaNotas" DockPanel.Dock="Left" Width="200" SelectionChanged="ListaNotas_SelectionChanged"/>

        <TextBox x:Name="tbxEditorTexto" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
        TextChanged="TextoEditorCambiado_TextChanged"/>

    </DockPanel>
</Window>
